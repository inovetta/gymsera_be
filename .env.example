# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# This API's own public URL. Staging: https://apistaging.gymsera.com (with its OWN PLATFORM_DB_NAME);
# production: https://api.gymsera.com. An APP_URL host containing "staging", NODE_ENV=staging or
# GYMSERA_ENV=staging marks staging, and staging refuses to start on the production platform
# database (NEW-131). Check a site's settings without starting: node src/scripts/check-environment.js
APP_URL=http://localhost:3000
CORS_ORIGIN=https://cmsstaging.gymsera.com,https://cms.gymsera.com,https://gymsera.com,https://apistaging.gymsera.com,http://localhost:3000,http://localhost:3001,http://localhost:3002

# ─── Platform MySQL ────────────────────────────────────────────────────────────
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=3306
PLATFORM_DB_NAME=gymsera_platform
# The PRODUCTION platform database name (default gymsera: what production connects to, NEW-134).
# Set it on every site if production uses another name, so staging can never start on it (NEW-131).
# A PLATFORM_DB_NAME set in the host or IIS environment wins over this file (dotenv never overrides);
# the boot line and `node src/scripts/check-environment.js` say which one is used.
# PRODUCTION_PLATFORM_DB_NAME=gymsera
PLATFORM_DB_USER=root
PLATFORM_DB_PASS=root

# ─── Tenant MySQL Server ────────────────────────────────────────────────────────
# This is the MySQL server where all per-tenant databases are created.
TENANT_DB_HOST=localhost
# Staging must use its own tenant database server, not production's: a staging site whose tenant host
# (TENANT_DB_HOST, else PLATFORM_DB_HOST) equals production's refuses to start (NEW-135).
# PRODUCTION_TENANT_DB_HOST=209.209.42.64
TENANT_DB_PORT=3306
TENANT_DB_ADMIN_USER=root
TENANT_DB_ADMIN_PASS=root
# Regular user granted access to each tenant DB on provisioning:
TENANT_DB_USER=gymsera_tenant
TENANT_DB_PASS=tenant_pass

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────────────────────────
# MUST be changed in production — use a long random string (64+ chars)
JWT_SECRET=change_this_jwt_secret_to_a_long_random_string_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_to_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# ─── Tenant DB Encryption ──────────────────────────────────────────────────────
# 64-character hex string (= 32 bytes for AES-256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TENANT_CONN_ENCRYPTION_KEY=change_this_to_a_64_char_hex_string_in_production_000000000000000

# ─── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GymsEra <noreply@gymsera.com>"

# ─── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ─── File Storage ──────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
AWS_REGION=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET=
# Cloudflare R2 Storage (Storage Service)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Private KYC Storage (SEC-10, Decision R-27)
# Dedicated private bucket name for sensitive KYC identity documents with SSE-AES256.
# When unset, defaults to ${R2_BUCKET}-kyc, or private local directory (storage/private/kyc).
R2_KYC_BUCKET=


# ─── Firebase Push Notifications (Sprint 7) ───────────────────────────────────
# Paste the full JSON content of your Firebase service-account key file.
# Leave blank for dev — push.service.js will log stubs instead.
# See: https://console.firebase.google.com → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── Subscription Expiry Cron ─────────────────────────────────────────────────
# EXPIRY_CRON_SCHEDULE defaults to '0 1 * * *' (01:00 daily).
# Override here only if you need a different schedule (e.g. for testing).
# EXPIRY_CRON_SCHEDULE=0 1 * * *
#
# On a traditional always-on server, this runs automatically via node-cron
# (see server.js). On Vercel, node-cron never boots (serverless functions
# don't stay alive), so Vercel Cron Jobs (configured in vercel.json) hit
# GET /api/v1/cron/subscription-expiry instead. Set CRON_SECRET so that
# endpoint can't be triggered by anyone else — Vercel automatically sends it
# as `Authorization: Bearer <CRON_SECRET>` for its own Cron Job invocations.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change_this_to_a_long_random_string_in_production

# ─── Audit Log ────────────────────────────────────────────────────────────────
# In production, audit entries are written to the Platform DB audit_logs table.
# In development, they are printed to console.
# Ensure the audit_logs table exists in Platform DB before enabling production logs.

# ─── Test Payment (dev/QA only, impossible in production) ─────────────────────
# Set a secret string here for local/QA testing. Pass it as X-Test-Payment-Key header
# when using method=TEST in POST /payments. Auto-completes the payment without a real
# gateway. Refused with 403 when NODE_ENV=production.
PAYMENT_TEST_KEY=test_payment_secret_change_me

# ─── Member pending payments (PAY-08) ─────────────────────────────────────────
# Hours a member-started pending payment (checkout, upgrade, renewal) waits for
# verification before it can expire. Default 168 (7 days, the invoice due date).
MEMBER_PAYMENT_PENDING_TTL_HOURS=168
# The daily job marks overdue ones EXPIRED (nothing is activated) only when this
# is "true". Turn it on after a mobile release that understands EXPIRED.
MEMBER_PAYMENT_EXPIRY_ENABLED=false

# ─── Biometric Device Integration ────────────────────────────────────────────
# Set to match the key sent by ZKTeco/biometric devices in x-device-api-key header.
DEVICE_API_KEY=device_secret_change_me

# ─── Apple IAP (App Store Server API) ─────────────────────────────────────────
# Existing, production-verified — documented here for completeness alongside
# the Android/Stripe blocks below, which follow the identical convention.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_BUNDLE_ID=
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_IAP_ENVIRONMENT=Sandbox

# ─── Sign in with Apple: revoke the token when an account is deleted (AUTH-07, R-28) ──
# A Sign in with Apple KEY (different from the IAP key above). Leave blank until you have one: account
# deletion still works, the revoke is just recorded as skipped. Never commit the .p8 file.
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_CLIENT_ID=
APPLE_SIGNIN_PRIVATE_KEY_PATH=

# ─── Google Play Billing ───────────────────────────────────────────────────────
# Paste the full JSON content of your Play Developer API service-account key
# (Play Console → Setup → API access). Leave blank / use placeholder
# BillingPlan product IDs until a real Play Console app exists — the service
# code runs regardless (see google-play-billing.service.js).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.gymsera.app
# Pub/Sub push authentication for Real-time Developer Notifications (SEC-03).
# Turn on authentication on the push subscription; each push then carries a
# Google-signed OIDC token that must match BOTH values below. Unset = every
# RTDN is refused with 401 (Pub/Sub retries; the daily sync still runs).
GOOGLE_PLAY_RTDN_AUDIENCE=https://api.example.com/api/v1/billing/webhooks/google
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=rtdn-push@your-project.iam.gserviceaccount.com

# ─── Stripe (website billing) ──────────────────────────────────────────────────
# Use TEST-mode keys until a production Stripe account exists — swapping to
# live later is a key change only, not a code change (stripe-billing.service.js).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Billing (owner decisions, spec §14) ─────────────────────────────────────
# Days a "pay later" host has to pay after approval (R-17 = R-22). Default 14.
PAY_LATER_GRACE_DAYS=14
# BILL-17 / R-7: new card payments on the web. Leave unset (off) until Stripe or a merchant of record is live.
# WEB_CARD_PAYMENTS_ENABLED=true

# ─── Bank Transfer Instructions for Platform / Host Onboarding (UX-15) ────────
# Public read-only instructions served via /api/v1/billing/bank-instructions.
# Leave blank or set real values in environment only. Never commit real account data.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_TITLE=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_SWIFT=
BANK_TRANSFER_CURRENCY=PKR
BANK_TRANSFER_INSTRUCTIONS=

# ── Rate limits (SEC-04) ─────────────────────────────────────────────────────
# All optional. Defaults are generous (mobile users share carrier NATs). Each rule has _MAX and _WINDOW_S:
#   LOGIN_IP 300/15 min · LOGIN_ID 30/15 min (per IP + account) · REGISTER_IP 100/h · REGISTER_ID 10/h
#   OTP_IP 200/15 min · OTP_ID 20/15 min · PWRESET_IP 100/h · PWRESET_ID 10/h
#   SEARCH_IP 120/min (public discovery) · MUTATION_USER 120/min (writes by one signed-in user) · REVEAL_USER 300/h (admin contact reveals)
# Example: RATE_LIMIT_LOGIN_IP_MAX=600  RATE_LIMIT_SEARCH_IP_WINDOW_S=60
# RATE_LIMIT_LOGIN_IP_MAX=
# RATE_LIMIT_MUTATION_USER_MAX=
# RATE_LIMIT_PLACES_USER_MAX=          (Phase 7 P3: /places calls per user per minute, default 90)

# ── Store price check (BILL-15) ───────────────────────────────────────────────
# A daily read-only job compares plan prices with Play Console. It runs only when GOOGLE_PLAY_SERVICE_ACCOUNT_JSON and
# GOOGLE_PLAY_PACKAGE_NAME are set (above). The service account needs access to read the app's subscriptions.
# PRICE_VERIFICATION_CRON=40 3 * * *

# NEW-126: how often the API re-checks that every tenant database is at the tenant schema
# target (read-only). A tenant behind or unreadable logs an error, raises TENANT_SCHEMA_BEHIND
# and makes GET /api/v1/health/tenant-schema answer 503. Default every 15 minutes.
# TENANT_SCHEMA_CHECK_CRON=*/15 * * * *

# SEC-06: what a strict route does with a request-body field it does not declare.
#   reject (default) = 422 validation_error naming the field; log = accept and log "[unknown-fields] ..."; off = no check.
# Roll out with log first if old app builds may still be in the field.
# UNKNOWN_FIELDS_MODE=reject

# NEW-81: force-update gate. The lowest app version allowed to run, per platform ("1.2.3" or "1.2.3+45").
# Unset or malformed = no gate. Served by GET /meta/app-config and inside GET /me/bootstrap.
# MIN_APP_VERSION_IOS=
# MIN_APP_VERSION_ANDROID=
# Where the update button goes (https only). Android defaults to the Play listing of com.inovettatech.gymsera.
# APP_STORE_URL_IOS=
# APP_STORE_URL_ANDROID=

# ─── 5xx error journal (NEW-123) ─────────────────────────────────────────────
# One JSON line per 5xx answer, with the reference id the app shows, in
# <ERROR_LOG_DIR>/errors-YYYY-MM-DD.jsonl (UTC). Unset: `logs/` in the app folder
# when NODE_ENV=production and not on Vercel; off elsewhere. `off` turns it off.
# On IIS the app pool identity needs write access to this folder. If it cannot be
# written, lines go to <os temp>/gymsera-logs and the console says so once. At startup
# a boot line names the file in use (`[ErrorJournal] boot ... journal=...`).
# ERROR_LOG_DIR=

# ─── Build id (NEW-130) ─────────────────────────────────────────────────────────
# /health and the boot line show the commit this process loaded. Without these: build-info.json
# ({ "commit", "builtAt" }) in the app folder, then the app folder's git checkout (git pull deploys).
# GYMSERA_BUILD_COMMIT=
# GYMSERA_BUILD_TIME=

# ─── Google Places (Phase 7 P3, R-76) ──────────────────────────────────────────
# Server key for /api/v1/places/* (city, area and address search, place details, reverse geocode).
# The server key from GymsEra's own Google Cloud project (R-76a); restrict it to this server's IP and
# to two APIs: Places API (New) and Geocoding API. Never commit it. Without it /places answers
# 503 places_not_configured and the apps say "Location search is not available right now".
GOOGLE_MAPS_SERVER_KEY=
# Optional: countries autocomplete searches when the selected city has no country yet (ISO 3166-1
# alpha-2, comma separated). Unset = pk. A city with a country (cities.country_code) always uses its own.
# GOOGLE_PLACES_REGION_CODES=pk
