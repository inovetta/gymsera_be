{
  "version": 1,
  "note": "Single source for GymsEra design tokens (spec 2.4). Source of truth: gymsera_be/docs/design-tokens.json; each client repo keeps a verbatim copy and its generated output. Color roles, not raw hexes, in components.",
  "color": {
    "background":        { "light": "#FAFAFA", "dark": "#0A0F1F" },
    "onBackground":      { "light": "#0F172A", "dark": "#F8FAFC" },
    "surface":           { "light": "#FFFFFF", "dark": "#0F1629" },
    "onSurface":         { "light": "#222222", "dark": "#F8FAFC" },
    "surfaceVariant":    { "light": "#F5F5F5", "dark": "#1E2536" },
    "onSurfaceVariant":  { "light": "#5F5F5F", "dark": "#A3AEC2" },
    "border":            { "light": "#DDDDDD", "dark": "#2A3247" },
    "brand":             { "light": "#FF5C00", "dark": "#FF5C00" },
    "primary":           { "light": "#C2410C", "dark": "#C2410C" },
    "onPrimary":         { "light": "#FFFFFF", "dark": "#FFFFFF" },
    "success":           { "light": "#007A04", "dark": "#4ADE80" },
    "onSuccess":         { "light": "#FFFFFF", "dark": "#052E16" },
    "warning":           { "light": "#8A5300", "dark": "#FBBF24" },
    "onWarning":         { "light": "#FFFFFF", "dark": "#2B1A00" },
    "danger":            { "light": "#C13515", "dark": "#F87171" },
    "onDanger":          { "light": "#FFFFFF", "dark": "#2A0A05" },
    "info":              { "light": "#0277BD", "dark": "#38BDF8" },
    "onInfo":            { "light": "#FFFFFF", "dark": "#04202F" },
    "roleOwner":         { "light": "#6A3DE8", "dark": "#A78BFA" },
    "roleManager":       { "light": "#1565C0", "dark": "#60A5FA" },
    "roleDesk":          { "light": "#0277BD", "dark": "#38BDF8" },
    "roleTrainer":       { "light": "#00796B", "dark": "#2DD4BF" },
    "onRole":            { "light": "#FFFFFF", "dark": "#0A0F1F" },
    "sidebar":           { "light": "#0F172A", "dark": "#0A0F1F" },
    "onSidebar":         { "light": "#F1F5F9", "dark": "#F1F5F9" },
    "sidebarAccent":     { "light": "#1E293B", "dark": "#141B2D" }
  },
  "contrast": [
    ["onBackground", "background", 4.5],
    ["onSurface", "surface", 4.5],
    ["onSurface", "surfaceVariant", 4.5],
    ["onSurfaceVariant", "surface", 4.5],
    ["onSurfaceVariant", "background", 4.5],
    ["onPrimary", "primary", 4.5],
    ["onSuccess", "success", 4.5],
    ["onWarning", "warning", 4.5],
    ["onDanger", "danger", 4.5],
    ["onInfo", "info", 4.5],
    ["onRole", "roleOwner", 4.5],
    ["onRole", "roleManager", 4.5],
    ["onRole", "roleDesk", 4.5],
    ["onRole", "roleTrainer", 4.5],
    ["onSidebar", "sidebar", 4.5],
    ["onSidebar", "sidebarAccent", 4.5],
    ["primary", "background", 3],
    ["brand", "surface", 3],
    ["border", "background", 1.2]
  ],
  "space": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "radius": { "sm": 6, "md": 8, "lg": 10, "xl": 16 },
  "elevation": {
    "none": "none",
    "low": "0 1px 2px rgba(0,0,0,0.06)",
    "mid": "0 4px 12px rgba(0,0,0,0.10)",
    "high": "0 12px 32px rgba(0,0,0,0.16)"
  },
  "typography": {
    "h1": { "size": 26, "weight": 700, "lineHeight": 1.3 },
    "h2": { "size": 20, "weight": 600, "lineHeight": 1.35 },
    "h3": { "size": 16, "weight": 600, "lineHeight": 1.4 },
    "body": { "size": 14, "weight": 400, "lineHeight": 1.5 },
    "caption": { "size": 12, "weight": 400, "lineHeight": 1.5 }
  },
  "motion": { "fast": 120, "base": 200, "slow": 300 }
}
